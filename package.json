{
  "name": "prosazhin_website",
  "description": "Personal site",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosazhin/prosazhin_website.git"
  },
  "author": "Evgenii Sazhin <prosazhin@gmail.com> (https://prosazhin.dev)",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "resume:generate": "node --import tsx scripts/generate-resumes.tsx",
    "resume:check": "node --import tsx scripts/check-resumes.ts",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev -p 8080 --turbopack --disable-source-maps",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=8192' next dev -p 8080 --webpack --disable-source-maps",
    "build": "next build --webpack",
    "postbuild": "next-sitemap",
    "postinstall": "patch-package",
    "start": "next start",
    "lint": "eslint . --no-warn-ignored",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,json,html,css}\"",
    "prepare": "npx simple-git-hooks",
    "text-local-build": "npm run build && npx next start -p 4000"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run -s resume:check && npx --no-install lint-staged --concurrent false --no-stash",
    "commit-msg": "npx --no-install commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,mdx,json,html,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings=0 --cache --fix --no-warn-ignored"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prosazhin/pbcomponents": "^1.1.0",
    "@prosazhin/pbstyles": "1.3.0",
    "@types/mdx": "^2.0.14",
    "dayjs": "^1.11.20",
    "fumadocs-core": "^16.15.11",
    "fumadocs-mdx": "^15.4.1",
    "fumadocs-ui": "^16.15.11",
    "globals": "^17.3.0",
    "i18next": "^26.0.1",
    "i18next-resources-to-backend": "^1.2.1",
    "next": "^16.2.11",
    "next-sitemap": "^4.2.3",
    "numeralize-ru": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.1",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.3.5",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "fast-uri": "^3.1.3",
    "js-cookie": "^3.0.7",
    "js-yaml": "^4.2.0",
    "flatted": "^3.4.2",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.0",
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.7"
    },
    "postcss": "^8.5.18",
    "picomatch": "^4.0.4",
    "yaml": "^2.8.3",
    "zod": "^4.5.4"
  }
}
